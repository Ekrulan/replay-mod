TICK {
	1 - t - 1 byte // при чтении файла 1 значит что блок tick.	
	tick - 4 byte // после того, как встретился 1, читаем следующие 4 байта, это tick.
}

UNITS {
	2  - u - 1 byte // при чтении файла 2 значит что блок units.
	id - 4 byte.
	type - 2 byte
	x - 4 byte
	y - 4 byte
	rot - 4 byte
	health - 4 byte
	team - 1 byte // анук использовал int, хотя хватает 1 байта. буду преоброзовывать byte в int.
	target - {
		x - 4 byte
		y - 4 byte
	} // target опциональный параметр, если null, заполнять нулями.

	итого: блок юнитов занимает 31 байт.
}

BLOCKS {
	3 - b - 1 byte // при чтении файла 3 значит что это blocks.
	id - 4 byte
	x - 2 byte
	y - 2 byte
	rot - 4 byte
	health - 4 byte
	team - 1 byte //  анук использовал int, хотя хватает 1 байта. буду преоброзовывать byte в int.

	// итого блок блоков занимает 17 байт.
}

логика работы:
читает первый байт файл, матчит что это(1, 2, 3). в зависимости от этого выбирает нужную ветку.
после того как дочитал все параметры нужного блока, читает следующий байт, опять матчит его и так по кругу.
